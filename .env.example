# Copy to .env (never commit it). Read by the Vite dev server only — not bundled.

# Platform API: live jobs and traces for the sandbox tenant.
# Default reaches the VM through an SSH tunnel:
#   ssh -N -L 127.0.0.1:8180:127.0.0.1:8180 ubuntu@10.100.14.2
PLATFORM_UPSTREAM=http://127.0.0.1:8180
PLATFORM_API_KEY=

# Docker (docker compose up): the console container reaches the platform API by name.
# PLATFORM_UPSTREAM is overridden in docker-compose.yml; only PLATFORM_API_KEY is needed there.
